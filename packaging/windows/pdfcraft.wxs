<?xml version="1.0" encoding="utf-8"?>
<!--
  PDF Avelton MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build pdfcraft.wxs installer-ui.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d ModelsDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, a desktop shortcut (on by default,
  optional), an App Paths entry, and PDF Avelton registered as a PDF handler (offered under "Open with"
  and in Default apps, never forced as the default). Files opened with PDF Avelton arrive on its
  command line.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="PDF Avelton"
      Manufacturer="Avelton"
      Version="$(var.Version)"
      UpgradeCode="ADAC6663-19C2-5FCD-ABC9-E27A74689B75"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="PDF Avelton PDF workbench" Manufacturer="Avelton" />
    <!-- HKLM registrations must never point into a per-user installation (#305). Allow removal
         of an existing installation even if an older MSI let it install per-user. -->
    <Launch Condition="ALLUSERS = 1 OR (Installed AND REMOVE = &quot;ALL&quot;)"
        Message="PDF Avelton must be installed for all users. Run setup with administrator privileges and ALLUSERS=1; per-user installation is not supported." />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of PDF Avelton is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Windows Installer requires an Icon id ending in .ico or .exe, or advertised shortcuts and
         Add/Remove Programs show a blank icon (#57). -->
    <Icon Id="PdfcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="PdfcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://pdf.avelton.online" />
    <Property Id="ARPURLUPDATEINFO" Value="https://pdf.avelton.online" />
    <Property Id="ARPHELPLINK" Value="https://github.com/avelton-ai/pdf-avelton/issues" />
    <!-- Desktop shortcut (#143): on by default, a checkbox in the full-UI welcome dialog, and
         INSTALLDESKTOPSHORTCUT=0 on the msiexec command line for unattended installs. Secure, so the
         choice made in the (unelevated) UI reaches the elevated install. -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />
    <UIRef Id="PdfcraftInstallerUI" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="PDF Avelton">
        <Directory Id="ModelsFolder" Name="models" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="PDF Avelton" Level="1">
      <ComponentGroupRef Id="PdfcraftFiles" />
      <ComponentGroupRef Id="PdfcraftModels" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="PdfcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="PdfcraftApp" Guid="F6A61839-23EA-5AB2-90A5-82AD9B0196BC">
        <File Id="PdfcraftExe" Source="$(var.BinDir)\pdf-avelton.exe" KeyPath="yes" />

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\pdf-avelton.exe" Value="[#PdfcraftExe]" Type="string" />

        <!-- PDF files (#107): PDF Avelton is offered under "Open with" and in Settings в–ё Default
             apps, through Windows' Default Programs registration (a ProgID, OpenWithProgids,
             Capabilities and RegisteredApplications). It never takes over an existing default:
             .pdf's own default value is left alone, and the user chooses. Without this, the only
             PDF Avelton entry to pick was the advertised Start Menu shortcut, which Windows can't
             run as a file handler ("This app can't run on your PC"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\AveltonPdf.Document" Value="PDF Document" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\AveltonPdf.Document\DefaultIcon" Value="[#PdfcraftExe],0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\AveltonPdf.Document\shell\open\command" Value="&quot;[#PdfcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pdf\OpenWithProgids" Name="AveltonPdf.Document" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\pdf-avelton.exe" Name="FriendlyAppName" Value="PDF Avelton" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\pdf-avelton.exe\SupportedTypes" Name=".pdf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\pdf-avelton.exe\shell\open\command" Value="&quot;[#PdfcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\PDF Avelton\Capabilities" Name="ApplicationName" Value="PDF Avelton" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\PDF Avelton\Capabilities" Name="ApplicationDescription" Value="Open-source PDF workbench" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\PDF Avelton\Capabilities" Name="ApplicationIcon" Value="[#PdfcraftExe],0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\PDF Avelton\Capabilities\FileAssociations" Name=".pdf" Value="AveltonPdf.Document" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="PDF Avelton" Value="Software\PDF Avelton\Capabilities" Type="string" />

        <!-- Image context menu (#190): convert without changing image file defaults. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\AveltonPdf.CreatePdf" Value="Create PDF with PDF AveltonвЂ¦" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\AveltonPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\AveltonPdf.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\AveltonPdf.CreatePdf" Value="Create PDF with PDF AveltonвЂ¦" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\AveltonPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\AveltonPdf.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\AveltonPdf.CreatePdf" Value="Create PDF with PDF AveltonвЂ¦" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\AveltonPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\AveltonPdf.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tif\shell\AveltonPdf.CreatePdf" Value="Create PDF with PDF AveltonвЂ¦" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tif\shell\AveltonPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tif\shell\AveltonPdf.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tiff\shell\AveltonPdf.CreatePdf" Value="Create PDF with PDF AveltonвЂ¦" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tiff\shell\AveltonPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tiff\shell\AveltonPdf.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.gif\shell\AveltonPdf.CreatePdf" Value="Create PDF with PDF AveltonвЂ¦" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.gif\shell\AveltonPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.gif\shell\AveltonPdf.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.bmp\shell\AveltonPdf.CreatePdf" Value="Create PDF with PDF AveltonвЂ¦" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.bmp\shell\AveltonPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.bmp\shell\AveltonPdf.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jp2\shell\AveltonPdf.CreatePdf" Value="Create PDF with PDF AveltonвЂ¦" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jp2\shell\AveltonPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jp2\shell\AveltonPdf.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.j2k\shell\AveltonPdf.CreatePdf" Value="Create PDF with PDF AveltonвЂ¦" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.j2k\shell\AveltonPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.j2k\shell\AveltonPdf.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpx\shell\AveltonPdf.CreatePdf" Value="Create PDF with PDF AveltonвЂ¦" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpx\shell\AveltonPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpx\shell\AveltonPdf.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
      </Component>

      <!-- Shortcuts (#143) are plain links to pdfcraft.exe, not advertised MSI shortcuts: advertised
           ones point at a Windows Installer descriptor rather than the program, which Windows can't
           use as a file handler (#107), and 0.2.1's advertised one went missing from the Start menu
           (#143). Each has its own component with an HKLM key path, so Windows Installer removes it
           on uninstall; in this per-machine package both folders are the all-users ones. -->
      <Component Id="PdfcraftStartMenuShortcut" Directory="ProgramMenuFolder" Guid="E5809E06-AB38-5541-A8AA-48E4C6B03CB1">
        <Shortcut Id="StartMenuShortcut" Name="PDF Avelton" Description="PDF Avelton PDF workbench"
            Target="[#PdfcraftExe]" WorkingDirectory="INSTALLFOLDER" Icon="PdfcraftIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\PDF Avelton\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="PdfcraftDesktopShortcut" Directory="DesktopFolder" Guid="56C7707E-9A8C-51EA-9DC4-32612E0554B8"
          Condition="INSTALLDESKTOPSHORTCUT = 1">
        <Shortcut Id="DesktopShortcut" Name="PDF Avelton" Description="PDF Avelton PDF workbench"
            Target="[#PdfcraftExe]" WorkingDirectory="INSTALLFOLDER" Icon="PdfcraftIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\PDF Avelton\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="PdfcraftCli">
        <File Id="PdfcraftCliExe" Source="$(var.BinDir)\pdf-avelton-cli.exe" KeyPath="yes" />
      </Component>
      <Component Id="AveltonNotices" Guid="E01C341A-C52F-5BD1-A3F5-3CCB82FD6D1D">
        <File Id="AveltonNotice0" Source="$(sys.SOURCEFILEDIR)..\..\NOTICE" />
        <File Id="AveltonNotice1" Source="$(sys.SOURCEFILEDIR)..\..\avelton.json" />
        <File Id="AveltonNotice2" Source="$(sys.SOURCEFILEDIR)..\..\assets\fonts\OFL-DancingScript.txt" />
        <File Id="AveltonNotice3" Source="$(sys.SOURCEFILEDIR)..\..\assets\fonts\OFL-Inter.txt" />
        <File Id="AveltonNotice4" Source="$(sys.SOURCEFILEDIR)..\..\assets\fonts\OFL-JetBrainsMono.txt" />
      </Component>
    </ComponentGroup>

    <!-- OCR models (#103), with their licences and ATTRIBUTION.txt, in models\ beside pdfcraft.exe
         where the app looks for them: every file `cargo xtask models` fetched (package.ps1), one
         component each, so new models ship without naming them here. -->
    <ComponentGroup Id="PdfcraftModels" Directory="ModelsFolder">
      <Files Include="$(var.ModelsDir)\*" />
    </ComponentGroup>
  </Fragment>
</Wix>
